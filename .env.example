# Local Development — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env
#
# In AWS ECS production, these are injected by the task definition
# via Secrets Manager and environment overrides — no .env file needed.

# Google Gemini (LLM + Embeddings) — REQUIRED
GEMINI_API_KEY=""

# Pinecone Vector DB — REQUIRED
PINECONE_API_KEY=""
PINECONE_INDEX_NAME=""

# AWS S3 + DynamoDB (leave empty for local-only mode with MemorySaver)
AWS_REGION="us-east-1"
S3_CLAIM_BUCKET=""
DYNAMODB_TABLE=""

# Environment (set to "local" to load .env; ECS sets this to "dev"/"prod")
ENV="local"

# Frontend CORS origins
LOCAL_FRONTEND_CLIENT_URL="http://localhost:3000"
EXTERNAL_FRONTEND_CLIENT_URL=""